{
  "manifest_version": 3,
  "name": "Rilldown Download Assistant",
  "version": "0.1.0",
  "description": "Send downloads and detected media to the Rilldown desktop app.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "downloads",
    "nativeMessaging",
    "storage",
    "tabs"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Rilldown",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "send-to-rilldown": {
      "suggested_key": {
        "default": "Alt+Shift+R"
      },
      "description": "Send the current page to Rilldown"
    }
  }
}
